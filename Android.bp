// Kernel is prebuilt for this device, so the headers LineageOS would generate
// via its soong plugin are exported straight from the prebuilt tree instead.
// kernel-headers-export omits asm/ and asm-generic/, which otherwise shadow
// bionic's own arch headers and redefine types such as struct sigaction.
cc_library_headers {
    name: "generated_kernel_headers",
    vendor_available: true,
    recovery_available: true,
    export_system_include_dirs: ["kernel-headers-export"],
}

cc_library_headers {
    name: "qti_kernel_headers",
    vendor_available: true,
    recovery_available: true,
    export_system_include_dirs: ["kernel-headers-export"],
}

cc_library_headers {
    name: "qti_display_kernel_headers",
    vendor_available: true,
    recovery_available: true,
    export_system_include_dirs: ["kernel-headers-export"],
}
